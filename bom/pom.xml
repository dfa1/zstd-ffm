<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.dfa1.zstd</groupId>
		<artifactId>zstd-ffm</artifactId>
		<version>0.15</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>zstd-bom</artifactId>
	<packaging>pom</packaging>
	<name>zstd-bom</name>
	<description>Bill of materials for the zstd-ffm modules</description>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-platform</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-rfc9842</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-osx-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-linux-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-linux-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-osx-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-windows-x86_64</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.dfa1.zstd</groupId>
				<artifactId>zstd-native-windows-aarch64</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Flattens the published POM: drops the zstd-ffm parent reference and
			     writes every managed dependency's ${project.version} out literally.
			     Importers get the BOM without also resolving the zstd-ffm parent.
			     Consumers still import it as <type>pom</type><scope>import</scope>. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>${flatten-maven-plugin.version}</version>
				<configuration>
					<flattenMode>bom</flattenMode>
					<pomElements>
						<properties>remove</properties>
					</pomElements>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
